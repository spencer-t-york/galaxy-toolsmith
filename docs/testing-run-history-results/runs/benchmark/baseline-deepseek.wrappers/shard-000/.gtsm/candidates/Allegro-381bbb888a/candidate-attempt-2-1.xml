<tool id="allegro" name="Allegro" version="0.1.0" profile="25.0">
  <description>Genetic linkage analysis and allele sharing calculations</description>
  <requirements>
    <requirement>allegro</requirement>
  </requirements>
  <command detect_errors="aggressive">
        allegro $input1 &gt; $output1
    </command>
  <inputs>
    <param name="input1" type="data" format="txt" label="Input file" />
  </inputs>
  <outputs>
    <data name="output1" format="txt" />
  </outputs>
  <tests>
    <test expect_num_outputs="1">
      <param name="input1" value="test_input.txt" />
      <output name="output1" file="test_output.txt">
        <has_text>Expected output text</has_text>
      </output>
    </test>
  </tests>
  <help format="markdown">
        # Allegro

        A tool for genetic linkage analysis and allele sharing calculations.

        ## Functionality

        - Parametric linkage analysis
        - Allele sharing models
        - Haplotype reconstruction
        - Recombination estimation

        ## Input

        Requires a text file with genetic data.

        ## Output

        Produces a text file with analysis results.
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>