<tool id="ampvis2_timeseries_plot" name="ampvis2 timeseries plot" version="0.1.0" profile="25.0">
  <description>Generates a timeseries plot showing relative read abundances over time</description>
  <requirements>
    <requirement type="package">ampvis2</requirement>
  </requirements>
  <command detect_errors="aggressive">
        Rscript $tool_directory/ampvis2_timeseries.R \
            --input $input1 \
            --metadata $input2 \
            --output $output1
    </command>
  <inputs>
    <param name="input1" type="data" format="RDS" optional="false">
      <metadata_column name="ampvis2_dataset" optional="true" />
    </param>
    <param name="input2" type="data" format="metadata_list" optional="false" />
  </inputs>
  <outputs>
    <data name="output1" format="html" />
  </outputs>
  <tests>
    <test expect_num_outputs="1">
      <has_text text="Timeseries plot" />
      <has_text text="ampvis2" />
    </test>
  </tests>
  <help format="markdown">
        # ampvis2 timeseries plot
        
        Generates a timeseries plot showing relative read abundances over time.
        
        ## Inputs
        
        - An ampvis2 RDS dataset
        - A metadata list
        
        ## Output
        
        - A timeseries plot in HTML format
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>