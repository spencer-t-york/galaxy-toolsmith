<tool id="autobigs.cli" name="autoBIGS.cli" version="0.6.2">
  <description>A command-line interface for batched requests for obtaining MLST profiles.</description>
  <requirements>
    <requirement type="package" version="0.6.2">iuc/autobigs</requirement>
  </requirements>
  <command detect_errors="aggressive">
        autoBIGS --operation $operation --fasta $fasta --database $database --schema_id $schema_id
    </command>
  <inputs>
    <param name="operation" type="select" label="Operation">
      <option value="retrieve_available_schemes_for_database">Retrieve Available Schemes for Database</option>
      <option value="perform_sequence_typing">Perform Sequence Typing</option>
    </param>
    <param name="fasta" type="data" format="fasta" label="FASTA File" />
    <param name="database" type="text" label="SeqDef Database Name" />
    <param name="schema_id" type="text" label="Schema ID" optional="true" />
  </inputs>
  <outputs>
    <output name="output" type="csv" label="MLST Profile" />
  </outputs>
  <tests>
    <test expect_num_outputs="1">
      <param name="operation" value="perform_sequence_typing" />
      <param name="fasta" value="example.fasta" />
      <param name="database" value="example_db" />
      <param name="schema_id" value="example_schema" />
      <output name="output" file="expected_output.csv" />
    </test>
  </tests>
  <help format="markdown">
        What is autoBIGS
        ================
        autoBIGS is a tool to help automatically perform multi-locus sequence typing (MLST) on given data by performing calls to necessary web BIGS database web APIs.

        Performing Sequence Typing
        ===========================
        Simply select "Perform Sequence Typing" for the "Operation" and select your FASTA files. Then, enter your SeqDef Database name and schema ID.
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>