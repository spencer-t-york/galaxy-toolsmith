<tool id="trimn" name="TrimN" version="0.1.0" profile="21.05">
  <description>TrimNs is part of the VGP pipeline, and is made of a series of python scripts which trim off large stretches of N bases and to remove fake cut sites that sometimes get inserted at the end of bionano hybrid scaffolds.</description>
  <macros />
  <requirements>
    <requirement type="package" version="3.8">python</requirement>
  </requirements>
  <command detect_errors="exit_code">
        python3 '$trimns_vgp'/'remove_fake_cut_sites_DNAnexus.py' '$input_fasta' '$output_fasta' '$output_log' &amp;&amp;
        python3 '$trimns_vgp'/'trim_Ns_DNAnexus.py' '$output_fasta' '$output_list'
    </command>
  <inputs>
    <param name="input_fasta" type="data" format="fasta" label="Input FASTA file" />
    <param name="trimns_vgp" type="select" label="TrimNs version">
      <option value="vgp-assembly-01ae8b83dbbc4ba77f8d6cd289999211e642e143/pipeline/bionano/trimNs">vgp-assembly-01ae8b83dbbc4ba77f8d6cd289999211e642e143/pipeline/bionano/trimNs</option>
    </param>
  </inputs>
  <outputs>
    <data name="output_fasta" format="fasta" label="${tool.name} on ${on_string}: TrimNs FASTA" />
    <data name="output_log" format="txt" label="${tool.name} on ${on_string}: TrimNs Log" />
    <data name="output_list" format="txt" label="${tool.name} on ${on_string}: TrimNs List" />
  </outputs>
  <tests>
    <test>
      <param name="input_fasta" value="input.fasta" />
      <param name="trimns_vgp" value="vgp-assembly-01ae8b83dbbc4ba77f8d6cd289999211e642e143/pipeline/bionano/trimNs" />
      <output name="output_fasta" file="output.fasta" ftype="fasta" />
      <output name="output_log" file="output.log" ftype="txt" />
      <output name="output_list" file="output.list" ftype="txt" />
    </test>
  </tests>
  <help>
.. class:: infomark

**What it does**

TrimNs is part of the VGP pipeline, and is made of a series of python scripts which trim off large stretches of N bases and to
remove fake cut sites that sometimes get inserted at the end of bionano hybrid scaffolds.
    </help>
  <citations>
    <citation type="doi">10.1038/s41586-020-2800-0</citation>
