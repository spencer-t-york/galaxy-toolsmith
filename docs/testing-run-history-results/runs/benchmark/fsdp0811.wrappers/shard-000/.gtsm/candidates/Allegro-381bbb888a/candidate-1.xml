<tool id="allegro" name="Allegro" version="1.0">
    <description>for multipoint genetic linkage analysis</description>
    <xrefs>
        <xref type="bio.tools">allegro</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="1.0">allegro</requirement>
    </requirements>
    <command detect_errors="exit_code">
        #if $input_format == "ped"
            #set $ped = $input
            #set $map = $map
        #else
            #set $ped = "input.ped"
            #set $map = "input.map"
            ln -s '$input' '$ped' &amp;&amp;
            ln -s '$map' '$map' &amp;&amp;
        #end if
