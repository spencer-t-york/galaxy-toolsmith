<tool id="alphagenome_sequence_predictor" name="AlphaGenome Sequence Predictor" version="0.6.1+galaxy0" profile="21.05">
    <description>Predict regulatory tracks from raw DNA sequence</description>
    <macros/><xrefs>
        <xref type="bio.tools">alphagenome</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="0.6.1">alphagenome</requirement>
    </requirements>
    <command detect_errors="exit_code">
        python '$__tool_directory__/alphagenome_sequence_predictor.py'
            --api_key '$api_key'
            --input_fasta '$input_fasta'
            --output_type $output_type
            --output_mode $output_mode
            --window_size $window_size
            --bin_size $bin_size
            --output '$output'
    </command>
