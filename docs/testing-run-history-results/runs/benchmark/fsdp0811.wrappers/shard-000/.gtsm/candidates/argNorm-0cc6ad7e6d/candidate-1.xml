<tool id="argnorm" name="argNorm" version="1.0.0+galaxy0" profile="21.05">
    <description>Normalize ARG annotations to the ARO</description>
    <macros/><xrefs>
        <xref type="bio.tools">argnorm</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="1.0.0">argnorm</requirement>
    </requirements>
