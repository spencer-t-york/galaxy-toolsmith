<tool id="alphagenome_ism_scanner" name="AlphaGenome ISM Scanner" version="0.6.1+galaxy0" profile="21.05">
    <description>performs in-silico saturation mutagenesis</description>
    <macros/><requirements>
        <requirement type="package" version="0.6.1">alphagenome</requirement>
    </requirements>
    <command detect_errors="exit_code">
        python '$__tool_directory__/alphagenome_ism_scanner.py'
            --api_key '$api_key'
            --input_bed '$input_bed'
            --output_tsv '$output_tsv'
            --output_html '$output_html'
            --variant_scorers '$variant_scorers'
            --max_width $max_width
    </command>
