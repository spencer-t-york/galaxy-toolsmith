<tool id="b2btools_single_sequence" name="b2bTools: Biophysical predictors for single sequences" version="0.1.0" profile="21.05">
    <description>using Bio2Byte tools</description>
    <macros/><requirements>
        <requirement type="package" version="0.1.0">b2btools</requirement>
    </requirements>
    <command detect_errors="exit_code">
        #if $input.is_of_type("fasta")
            ln -s '$input' input.fasta &amp;&amp;
        #else
            ln -s '$input' input.fasta.gz &amp;&amp;
        #end if
        b2btools-single-sequence
            --input input.fasta
            --output output
            --threads \${GALAXY_SLOTS:-1}
            #if $plot
                --plot
            #end if
            #if $plot_all
                --plot-all
            #end if
            #if $predictors.dynamine
                --dynamine
            #end if
            #if $predictors.disomine
                --disomine
            #end if
            #if $predictors.efoldmine
                --efoldmine
            #end if
            #if $predictors.agmata
                --agmata
            #end if
    </command>
    <inputs>
        <param name="input" type="data" format="fasta,fasta.gz" label="Input sequences"/>
        <param name="predictors" type="select" multiple="true" label="Predictors to run">
            <option value="dynamine" selected="true">DynaMine</option>
            <option value="disomine" selected="true">DisoMine</option>
            <option value="efoldmine" selected="true">EFoldMine</option>
            <option value="agmata" selected="true">AgMata</option>
        </param>
        <param name="plot" type="boolean" truevalue="--plot" falsevalue="" label="Plot per sequence" help="If checked, the tool will generate a plot for each predicted feature per sequence"/>
        <param name="plot_all" type="boolean" truevalue="--plot-all" falsevalue="" label="Plot all sequences" help="If checked, the tool will generate a plot for each predicted feature containing all sequences"/>
    </inputs>
    <outputs>
        <data name="json" format="json" from_work_dir="output.json" label="${tool.name} on ${on_string}: JSON"/>
        <data name="tabular" format="tabular" from_work_dir="output.tsv" label="${tool.name} on ${on_string}: Tabular"/>
        <collection name="plots" type="list" label="${tool.name} on ${on_string}: Plots">
            <discover_datasets pattern="(?P&lt;designation&gt;.+)\.png" format="png" directory="output"/>
        </collection>
    </outputs>
    <tests>
        <test expect_num_outputs="3">
            <param name="input" value="input.fasta"/>
            <param name="predictors" value="dynamine,disomine,efoldmine,agmata"/>
            <param name="plot" value="true"/>
            <param name="plot_all" value="true"/>
            <output name="json" file="output.json" ftype="json" compare="sim_size"/>
            <output name="tabular" file="output.tsv" ftype="tabular" compare="sim_size"/>
            <output_collection name="plots" type="list" count="100">
