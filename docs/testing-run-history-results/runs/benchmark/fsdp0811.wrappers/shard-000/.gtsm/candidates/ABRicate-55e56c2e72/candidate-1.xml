<tool id="abricate" name="ABRicate" version="1.4.0+galaxy0" profile="21.05">
    <description>Antibiotic resistance gene finder</description>
    <macros/><xrefs>
        <xref type="bio.tools">abricate</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="1.4.0">abricate</requirement>
    </requirements>
    <command detect_errors="exit_code">
        abricate
        #if $input.is_of_type('fasta'):
            -f fasta
        #else if $input.is_of_type('genbank'):
            -f genbank
        #end if
        -d '$database'
        '$input'
        &gt; '$output'
    </command>
