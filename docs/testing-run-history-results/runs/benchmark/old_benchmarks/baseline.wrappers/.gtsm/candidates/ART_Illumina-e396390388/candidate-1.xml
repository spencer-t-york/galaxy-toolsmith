<tool id="art_illumina" name="ART Illumina" version="0.1.0" profile="25.0">
  <description>Simulate Illumina sequencing reads</description>
  <requirements>
    <requirement type="package" version="454">art_profiler_454</requirement>
    <requirement type="package" version="illumina">art_profiler_illumina</requirement>
  </requirements>
  <command detect_errors="aggressive">
        art_illumina -i $input -o $output_prefix --reads $reads --len $length --mflen $mflen --sdev $sdev --qual $quality --seqtype $seqtype --out $output_suffix
    </command>
  <inputs>
    <param name="input" type="directory" label="Input directory containing FASTQ files" />
    <param name="output_prefix" type="text" label="Output prefix" />
    <param name="reads" type="select" label="Read type">
      <option value="single">Single-end</option>
      <option value="paired">Paired-end</option>
      <option value="matepair">Mate-pair</option>
    </param>
    <param name="length" type="integer" label="Read length" min="1" />
    <param name="mflen" type="integer" label="Mean fragment length" min="1" />
    <param name="sdev" type="float" label="Standard deviation" min="0" />
    <param name="quality" type="float" label="Quality score" min="0" />
    <param name="seqtype" type="select" label="Sequence type">
      <option value="DNA">DNA</option>
      <option value="RNA">RNA</option>
    </param>
    <param name="output_suffix" type="text" label="Output suffix" />
  </inputs>
  <outputs>
    <data name="output_fastq" format="fastq" label="Generated FASTQ file" />
    <data name="output_aln" format="sam" label="Alignment file" />
  </outputs>
  <tests>
    <test expect_num_outputs="2">
      <param name="input" value="sample_input" />
      <param name="output_prefix" value="test_output" />
      <param name="reads" value="single" />
      <param name="length" value="150" />
      <param name="mflen" value="300" />
      <param name="sdev" value="10" />
      <param name="quality" value="30" />
      <param name="seqtype" value="DNA" />
      <param name="output_suffix" value=".fq" />
      <assert_contents>
        <has_text filename="test_output.fq" substring="@HWI-ST1234:1:1101:1234:1234:ACCGGTAT/1" />
        <has_text filename="test_output.sam" substring="@HD VN:1.6 SO:unsorted" />
      </assert_contents>
    </test>
  </tests>
  <help format="markdown">
        Simulates Illumina sequencing reads based on input FASTQ files.
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>