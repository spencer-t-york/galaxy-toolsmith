<tool id="ampvis2_rarefaction_curve" name="ampvis2 rarefaction curve" version="0.1.0" profile="25.0">
  <description>Generates a rarefaction curve for each sample.</description>
  <requirements>
    <requirement type="package" version="&gt;=2.0">R</requirement>
    <requirement type="package" version="&gt;=1.0">ampvis2</requirement>
  </requirements>
  <command detect_errors="aggressive">
        Rscript -e "library(ampvis2); amp_rarecurve(input_file = '$input', metadata = '$metadata', output_format = '$output_format')"
    </command>
  <inputs>
    <param name="input" type="data" format="rds" label="AmpVis2 RDS Dataset" />
    <param name="metadata" type="data" format="tabular" label="Metadata List" />
    <param name="output_format" type="select" label="Output Format">
      <option value="html">HTML</option>
      <option value="txt">Text</option>
    </param>
  </inputs>
  <outputs>
    <data name="output" format="$output_format" label="Rarefaction Curves" />
  </outputs>
  <tests>
    <test expect_num_outputs="1">
      <param name="input" value="sample.rds" />
      <param name="metadata" value="metadata.tabular" />
      <param name="output_format" value="html" />
      <assert_contents filename="output.html" />
    </test>
  </tests>
  <help format="markdown">
        Generates a rarefaction curve for each sample. The plot can be colored or faceted by metadata.
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>