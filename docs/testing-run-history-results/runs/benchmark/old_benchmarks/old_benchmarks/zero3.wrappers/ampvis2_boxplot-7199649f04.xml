<tool id="ampvis2_boxplot" name="ampvis2 boxplot" version="0.1.0+galaxy0" profile="24.09">
  <description>generates boxplots of the most abundant taxa</description>
  <macros />
  <xrefs>
    <xref type="bio.tools">ampvis2</xref>
  </xrefs>
  <requirements>
    <requirement type="package" version="1.6.0">R</requirement>
    <requirement type="package" version="1.6.0">r-base</requirement>
    <requirement type="package" version="1.6.0">r-ggplot2</requirement>
    <requirement type="package" version="1.6.0">r-dplyr</requirement>
    <requirement type="package" version="1.6.0">r-tidyr</requirement>
    <requirement type="package" version="1.6.0">r-readr</requirement>
    <requirement type="package" version="1.6.0">r-stringr</requirement>
    <requirement type="package" version="1.6.0">r-purrr</requirement>
    <requirement type="package" version="1.6.0">r-magrittr</requirement>
    <requirement type="package" version="1.6.0">r-lubridate</requirement>
    <requirement type="package" version="1.6.0">r-scales</requirement>
    <requirement type="package" version="1.6.0">r-forcats</requirement>
    <requirement type="package" version="1.6.0">r-knitr</requirement>
    <requirement type="package" version="1.6.0">r-rmarkdown</requirement>
    <requirement type="package" version="1.6.0">r-htmltools</requirement>
    <requirement type="package" version="1.6.0">r-xtable</requirement>
    <requirement type="package" version="1.6.0">r-ampr</requirement>
  </requirements>
  <command detect_errors="exit_code">
Rscript '$__tool_directory__/ampvis2_boxplot.R'
--input '$input'
--metadata '$metadata'
--output '$output'
--format '${format}'
    </command>
  <inputs>
    <param argument="--input" type="data" format="rds" label="Ampvis2 dataset" />
    <param argument="--metadata" type="data" format="tabular" label="Metadata table" />
    <param argument="--format" type="select" label="Output format">
      <option value="html" selected="true">HTML</option>
      <option value="png">PNG</option>
      <option value="pdf">PDF</option>
    </param>
  </inputs>
  <outputs>
    <data name="output" format="${format}" label="${tool.name} on ${on_string}: ${format}" />
  </outputs>
  <tests>
    <test>
      <param name="input" ftype="rds" value="ampvis2_dataset.rds" />
      <param name="metadata" ftype="tabular" value="metadata.tabular" />
      <param name="format" value="html" />
      <output name="output" file="boxplot.html" compare="sim_size" />
    </test>
  </tests>
  <help>
What it does
============

Generates boxplots of the most abundant taxa.

The Galaxy tool calls the `amp_boxplot
&lt;https://kasperskytte.github.io/ampvis2/reference/amp_boxplot.html&gt;`_ function
of the ampvis2 package.

Input
=====


        An ampvis2 RDS dataset obtained by the ``ampvis2: load`` tool (or ``ampvis2: mergereplicates`` or one of the
        ``ampvis2: subset ...`` tools).



        The metadata list output of the ``ampvis2: load`` tool (or ``ampvis2: mergereplicates`` or the
        ``ampvis2: subset sample`` tool).  This input is only used for providing
        values to the parameters alowing to select metadata variables or values.


Output
======

Boxplot in the chosen output format.
    </help>
