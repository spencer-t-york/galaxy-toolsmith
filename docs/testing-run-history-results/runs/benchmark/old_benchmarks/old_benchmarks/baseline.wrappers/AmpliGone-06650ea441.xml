<tool id="ampligone" name="AmpliGone" version="2.0.1" profile="25.0">
  <description>Remove primer sequences from NGS reads using AmpliGone</description>
  <requirements>
    <requirement type="package" version="2.0.1">ampligone</requirement>
  </requirements>
  <command detect_errors="aggressive">
        ampligone -i $input -o $output -t $threads -a $amplicon_type -b $bed_file -f $format
    </command>
  <inputs>
    <param name="input" type="data" format="fastq,bam" label="Input data" />
    <param name="bed_file" type="data" format="bed" label="BED file" />
    <param name="threads" type="integer" value="16" min="1" max="100" label="Number of threads" />
    <param name="amplicon_type" type="select" label="Amplicon type">
      <option value="end-to-end">End-to-end</option>
      <option value="end-to-mid">End-to-mid</option>
      <option value="fragmented">Fragmented</option>
    </param>
    <param name="format" type="select" label="Output format">
      <option value="html">HTML</option>
      <option value="txt">Text</option>
    </param>
  </inputs>
  <outputs>
    <data name="output" format="html,txt" label="Cleaned reads" />
  </outputs>
  <tests>
    <test expect_num_outputs="1">
      <param name="input" value="sample.fastq" />
      <param name="bed_file" value="sample.bed" />
      <param name="threads" value="4" />
      <param name="amplicon_type" value="end-to-end" />
      <param name="format" value="html" />
      <output name="output" file="cleaned_reads.html" />
    </test>
  </tests>
  <help format="markdown">
        **AmpliGone**

        Removes primer sequences from NGS reads using AmpliGone. Supports both FASTQ and BAM formats. Trims reads based on primer sequence coordinates in relation to a given reference sequence.
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>