<tool id="ampvis2_timeseries_plot" name="ampvis2 timeseries plot" version="0.1.0" profile="25.0">
  <description>Generates a timeseries plot showing relative read abundances over time.</description>
  <requirements>
    <requirement type="package" version="&gt;=2.0">R</requirement>
    <requirement type="package" version="&gt;=1.0">ggplot2</requirement>
  </requirements>
  <command detect_errors="aggressive">
        Rscript -e "library(ampvis2); library(ggplot2); amp_timeseries(input_rds, metadata_list, output_file = '${output_file}')"
    </command>
  <inputs>
    <param name="input_rds" type="data" format="rds" label="AmpVis2 RDS Dataset" />
    <param name="metadata_list" type="data" format="txt" label="Metadata List" />
    <boolean name="normalise" checked="true" truevalue="TRUE" falsevalue="FALSE" label="Normalise Read Counts" />
    <param name="output_format" type="select" label="Output Format">
      <option value="html">HTML</option>
      <option value="png">PNG</option>
      <option value="pdf">PDF</option>
    </param>
  </inputs>
  <outputs>
    <data name="output_plot" format="${output_format}" label="Timeseries Plot" />
  </outputs>
  <tests>
    <test expect_num_outputs="1">
      <param name="input_rds" value="ampvis2_subset_sample.rds" />
      <param name="metadata_list" value="metadata.txt" />
      <param name="normalise" value="false" />
      <param name="output_format" value="html" />
      <assert_contents filename="timeseries_plot.html" />
    </test>
  </tests>
  <help format="markdown">
        Generates a timeseries plot showing relative read abundances over time. By default, raw read counts are normalised. Disable normalisation if subsetting was done with normalisation enabled.
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>