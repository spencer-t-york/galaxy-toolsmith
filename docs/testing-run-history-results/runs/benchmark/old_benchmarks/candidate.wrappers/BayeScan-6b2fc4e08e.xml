<tool id="bayescan" name="BayeScan" version="2.1.0" profile="25.0">
  <description>Identifies candidate loci under natural selection from genetic data</description>
  <requirements>
    <requirement type="package" version="2.1">bayescan</requirement>
  </requirements>
  <command detect_errors="aggressive">
        bayescan2 $input_file -n $num_loci -s $num_snp -p $prior -o $output_prefix
    </command>
  <inputs>
    <param name="input_file" type="data" format="txt" label="Input file" help="BayeScan input file" />
    <param name="num_loci" type="integer" value="10" label="Number of loci" help="Number of loci to analyze" />
    <param name="num_snp" type="integer" value="100" label="Number of SNPs" help="Number of SNPs per locus" />
    <param name="prior" type="select" label="Prior distribution" help="Prior distribution for the analysis">
      <option value="uniform">Uniform</option>
      <option value="exponential">Exponential</option>
    </param>
    <param name="output_prefix" type="text" value="bayescan_output" label="Output prefix" help="Prefix for output files" />
  </inputs>
  <outputs>
    <data name="log_likelihood" format="tabular" label="Log likelihood output" />
    <data name="posterior_probabilities" format="tabular" label="Posterior probabilities output" />
  </outputs>
  <tests>
    <test expect_num_outputs="2">
      <param name="input_file" value="test_input.txt" />
      <param name="num_loci" value="5" />
      <param name="num_snp" value="50" />
      <param name="prior" value="uniform" />
      <param name="output_prefix" value="test_output" />
      <output name="log_likelihood" file="test_log_likelihood.tabular" />
      <output name="posterior_probabilities" file="test_posterior_probabilities.tabular" />
    </test>
  </tests>
  <help format="markdown">
        BayeScan identifies candidate loci under natural selection from genetic data using differences in allele frequencies between populations.
        
        For more information, see the [BayeScan manual](http://cmpg.unibe.ch/software/BayeScan/files/BayeScan2.1_manual.pdf).
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>