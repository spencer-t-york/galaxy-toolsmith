<tool id="ampvis2_rarefaction_curve" name="ampvis2 rarefaction curve" version="0.1.0" profile="25.0">
  <description>Generates a rarefaction curve for each sample.</description>
  <requirements>
    <requirement type="package" version="1.0.0">R</requirement>
    <requirement type="package" version="1.0.0">ggplot2</requirement>
  </requirements>
  <command detect_errors="aggressive">
        Rscript -e "library(ampvis2); library(ggplot2); amp_rarecurve(input_file, metadata = metadata_file, output_format = '$output_format')"
    </command>
  <inputs>
    <param name="input_file" type="data" format="rds" label="AmpVis2 RDS Dataset" />
    <param name="metadata_file" type="data" format="txt" label="Metadata List" />
    <param name="output_format" type="select" label="Output Format">
      <option value="html">HTML</option>
      <option value="png">PNG</option>
      <option value="pdf">PDF</option>
    </param>
  </inputs>
  <outputs>
    <data name="output_file" format="$output_format" label="Rarefaction Curve" />
  </outputs>
  <tests>
    <test expect_num_outputs="1">
      <param name="input_file" value="sample.rds" />
      <param name="metadata_file" value="sample_metadata.txt" />
      <param name="output_format" value="html" />
      <output name="output_file" file="sample_rarecurve.html" />
    </test>
  </tests>
  <help format="markdown">
        Generates a rarefaction curve (number of reads vs number of observed OTUs) for each sample.
        The plot can be colored or faceted (i.e. split into multiple panels) by metadata.
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>