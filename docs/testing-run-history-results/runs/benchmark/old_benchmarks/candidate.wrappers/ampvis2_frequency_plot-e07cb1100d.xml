<tool id="ampvis2_frequency_plot" name="ampvis2 frequency plot" version="0.1.0" profile="25.0">
  <description>Generates a barplot with frequency vs read abundance.</description>
  <requirements>
    <requirement type="package" version="&gt;=1.0">R</requirement>
    <requirement type="package" version="&gt;=2.0">ggplot2</requirement>
  </requirements>
  <command detect_errors="aggressive">
        Rscript -e "library(ampvis2); library(ggplot2); amp_frequency(input_rds, metadata_list, output_file = '$output_html')"
    </command>
  <inputs>
    <param name="input_rds" type="data" format="rds" label="Ampvis2 RDS Dataset" />
    <param name="metadata_list" type="data" format="txt" label="Metadata List" />
  </inputs>
  <outputs>
    <data name="output_html" format="html" label="Frequency Plot" />
  </outputs>
  <tests>
    <test expect_num_outputs="1">
      <param name="input_rds" value="sample.rds" />
      <param name="metadata_list" value="sample_metadata.txt" />
      <output name="output_html" file="expected_output.html" />
    </test>
  </tests>
  <help format="markdown">
        Generates a barplot with frequency vs read abundance using the `amp_frequency` function from the ampvis2 package.
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>