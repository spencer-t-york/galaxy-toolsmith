<tool id="abyss" name="ABySS" version="2.3.10">
  <description>De novo sequence assembler for short paired-end reads and large genomes</description>
  <macros>
    <token name="abyss_db_txt">abyss-db-txt</token>
    <token name="abyss_db_csv">abyss-db-csv</token>
  </macros>
  <requirements>
    <requirement type="package" version="2.3.10">abyss</requirement>
  </requirements>
  <command detect_errors="aggressive">
        abyss-pe k=$k threads=$threads in=$in out=$out
    </command>
  <inputs>
    <param name="in" type="data" format="fastq,fasta" multiple="true" label="Input FASTQ/FASTA files" />
    <param name="k" type="integer" value="91" min="1" max="1000" label="Kmer size" />
    <param name="threads" type="integer" value="4" min="1" label="Number of threads" />
  </inputs>
  <outputs>
    <collection name="out" type="list" label="Output assemblies">
      <element name="contigs" format="fasta" label="Contigs" />
      <element name="scaffolds" format="fasta" label="Scaffolds" />
    </collection>
  </outputs>
  <tests>
    <test expect_num_outputs="1">
      <input name="in" value="sample.fastq.gz" />
      <output name="out" collection_type="list">
        <element name="contigs" file="contigs.fasta" />
        <element name="scaffolds" file="scaffolds.fasta" />
      </output>
    </test>
  </tests>
  <help format="markdown">
        ABySS is a de novo sequence assembler designed for short paired-end reads and large genomes.
        
        **Inputs**
        - Multiple FASTQ/FASTA files.
        - Kmer size (default: 91).
        - Number of threads (default: 4).
        
        **Outputs**
        - Contigs in FASTA format.
        - Scaffolds in FASTA format.
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>