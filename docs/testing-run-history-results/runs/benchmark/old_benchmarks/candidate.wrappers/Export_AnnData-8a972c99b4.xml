<tool id="export_anndata" name="Export AnnData" version="0.1.0" profile="25.0">
  <description>Exports an AnnData dataset to tabular files</description>
  <requirements>
    <requirement type="package" version="0.11.4">anndata</requirement>
  </requirements>
  <command detect_errors="aggressive">
        python -m anndata write_csvs $input $output_dir
    </command>
  <inputs>
    <param name="input" type="data" format="h5ad" label="Input AnnData file" />
    <param name="output_dir" type="text" value="exported_files" label="Output directory" />
  </inputs>
  <outputs>
    <collection name="output_files" type="list" label="Exported Files">
      <element name="expression_matrix" format="tabular" label="Expression Matrix" />
      <element name="obs_metadata" format="tabular" label="Observations Metadata" />
      <element name="var_metadata" format="tabular" label="Variables Metadata" />
    </collection>
  </outputs>
  <tests>
    <test expect_num_outputs="1">
      <param name="input" value="sample.h5ad" />
      <param name="output_dir" value="test_output" />
      <output_collection name="output_files">
        <element name="expression_matrix" file="test_output/X.csv" />
        <element name="obs_metadata" file="test_output/obs.csv" />
        <element name="var_metadata" file="test_output/var.csv" />
      </output_collection>
    </test>
  </tests>
  <help format="markdown">
        This tool exports an AnnData dataset to tabular files using the `write_csvs` method.
    </help>
  <citations>
    <citation type="bibtex">@misc{galaxy_toolsmith,
  title = {Galaxy Toolsmith},
  howpublished = {\url{https://github.com/BlankenbergLab/galaxy-toolsmith}},
  url = {https://github.com/BlankenbergLab/galaxy-toolsmith}
}</citation>
  </citations>
</tool>