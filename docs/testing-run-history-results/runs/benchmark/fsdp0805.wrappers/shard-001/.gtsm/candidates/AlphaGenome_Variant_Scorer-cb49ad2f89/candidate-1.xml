<tool id="alphagenome_variant_scorer" name="AlphaGenome Variant Scorer" version="0.1.0+galaxy0" profile="23.0">
  <description>Score genetic variants using AlphaGenome's score_variant() API</description>
  <macros />
  <xrefs>
    <xref type="bio.tools">alphagenome</xref>
  </xrefs>
  <requirements>
    <requirement type="package" version="0.6.1">alphagenome</requirement>
