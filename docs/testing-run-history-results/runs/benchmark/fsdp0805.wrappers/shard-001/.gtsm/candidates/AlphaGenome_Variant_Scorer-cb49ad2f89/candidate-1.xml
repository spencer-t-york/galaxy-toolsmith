        <option value="DNASE_ACTIVE">DNASE_ACTIVE</option>
        <option value="CAGE">CAGE</option>
        <option value="PROCAP">PROCAP</option>
        <option value="CAGE_ACTIVE">CAGE_ACTIVE</option>
        <option value="PROCAP_ACTIVE">PROCAP_ACTIVE</option>
        <option value="CHIP_TF">CHIP_TF</option>
        <option value="CHIP_HISTONE">CHIP_HISTONE</option>
        <option value="CHIP_TF_ACTIVE">CHIP_TF_ACTIVE</option>
        <option value="CHIP_HISTONE_ACTIVE">CHIP_HISTONE_ACTIVE</option>
