<tool id="argnorm" name="argNorm" version="1.0.0+galaxy0" profile="24.1">
    <description>Normalize antibiotic resistance genes to the ARO</description>
    <macros/><xrefs>
        <xref type="bio.tools">argnorm</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="1.0.0">argnorm</requirement>
    </requirements>
    <command detect_errors="exit_code">
        ln -s '$input' input.tsv &amp;&amp;
        argnorm
            --input input.tsv
            --output output.tsv
            --arogene-table '$arogene_table'
            --arodrug-table '$arodrug_table'
            --log output.log
    </command>
    <inputs>
        <param argument="--input" type="data" format="tabular" label="Input file"/>
        <param argument="--arogene-table" type="select" label="Select ARO gene table">
            <options from_data_table="argnorm_arogene_tables"/>
        </param>
        <param argument="--arodrug-table" type="select" label="Select ARO drug table">
            <options from_data_table="argnorm_arodrug_tables"/>
        </param>
    </inputs>
    <outputs>
        <data name="output" format="tabular" from_work_dir="output.tsv" label="${tool.name} on ${on_string}: normalized ARG annotations"/>
        <data name="log" format="html" from_work_dir="output.log" label="${tool.name} on ${on_string}: log"/>
    </outputs>
    <tests>
        <test expect_num_outputs="2">
            <param name="input" value="resfinder_output.tabular"/>
            <param name="arogene_table" value="rgi_gene.tsv"/>
            <param name="arodrug_table" value="rgi_drug.tsv"/>
            <output name="output" ftype="tabular">
                <assert_contents>
