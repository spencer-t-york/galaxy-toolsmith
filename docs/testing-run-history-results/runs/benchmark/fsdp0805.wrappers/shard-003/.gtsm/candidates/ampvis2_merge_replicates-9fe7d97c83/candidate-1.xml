<tool id="ampvis2_merge_replicates" name="ampvis2 merge replicates" version="2.4+galaxy0" profile="21.05">
  <description>aggregate read counts in replicate samples</description>
  <macros />
  <xrefs>
    <xref type="bio.tools">ampvis2</xref>
  </xrefs>
  <requirements>
    <requirement type="package" version="2.4">iuc-ampvis2</requirement>
  </requirements>
  <version_command>Rscript -e 'cat(system.file("DESCRIPTION", package = "ampvis2"), sep = "\n")'</version_command>
  <command detect_errors="exit_code">
        Rscript '$__tool_directory__/mergeReplicates.R'
            --input '$input'
            --metadata '$metadata'
            #if $select_metadata.select == 'yes':
                --select_metadata '$select_metadata.metadata'
            #end if
            #if $select_metadata.value:
                --value '$select_metadata.value'
            #end if
            #if $group_by.group_by_select == 'yes':
                --group_by '$group_by.group_by'
            #end if
            #if $group_by.group_by_value:
                --group_by_value '$group_by.group_by_value'
            #end if
            --output '$output'
    </command>
  <inputs>
    <param argument="--input" type="data" format="rds" label="AmpVis2 dataset" />
    <param argument="--metadata" type="data" format="tabular" label="Metadata file" />
    <conditional name="select_metadata">
      <param name="select" type="select" label="Select metadata variable(s) to filter on">
        <option value="no">No</option>
        <option value="yes">Yes</option>
      </param>
      <when value="no" />
      <when value="yes">
        <param argument="--metadata" type="text" label="Metadata variable(s)" help="Comma-separated list of metadata variables to filter on." />
      </when>
    </conditional>
    <conditional name="group_by">
      <param name="group_by_select" type="select" label="Group by metadata variable(s)">
        <option value="no">No</option>
        <option value="yes">Yes</option>
      </param>
      <when value="no" />
      <when value="yes">
        <param argument="--group_by" type="text" label="Metadata variable(s)" help="Comma-separated list of metadata variables to group by." />
      </when>
    </conditional>
  </inputs>
  <outputs>
    <data name="output" format="html" />
  </outputs>
  <tests>
    <test>
      <param name="input" ftype="rds" value="mergeReplicates_test.rds" />
      <param name="metadata" ftype="tabular" value="mergeReplicates_test.tabular" />
      <param name="select" value="yes" />
      <param name="metadata" value="SampleID" />
      <param name="group_by_select" value="yes" />
      <param name="group_by" value="Treatment" />
      <output name="output" file="mergeReplicates_test.html" compare="sim_size" />
    </test>
  </tests>
  <help>
What it does
============

Aggregates read counts in replicate samples by calculating the mean abundances of OTU's

The Galaxy tool calls the `amp_mergereplicates
&lt;https://kasperskytte.github.io/ampvis2/reference/amp_merge_replicates.html&gt;`_ function
of the ampvis2 package.

Input
=====


        An ampvis2 RDS dataset obtained by the ``ampvis2: load`` tool (or ``ampvis2: mergereplicates`` or one of the
        ``ampvis2: subset ...`` tools).



        The metadata list output of the ``ampvis2: load`` tool (or ``ampvis2: mergereplicates`` or the
        ``ampvis2: subset sample`` tool).  This input is only used for providing
        values to the parameters alowing to select metadata variables or values.


Output
======

An rank abundance plot in the chosen output format.
    </help>
