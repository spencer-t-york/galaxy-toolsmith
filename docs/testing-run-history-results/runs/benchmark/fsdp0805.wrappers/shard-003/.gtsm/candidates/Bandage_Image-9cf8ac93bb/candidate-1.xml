<tool id="bandage_image" name="Bandage Image" version="2022.09+galaxy0" profile="24.1">
    <description>generate an image file of the graph visualisation</description>
    <macros/><xrefs>
        <xref type="bio.tools">bandage</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="2022.09">iuc_bandage</requirement>
    </requirements>
