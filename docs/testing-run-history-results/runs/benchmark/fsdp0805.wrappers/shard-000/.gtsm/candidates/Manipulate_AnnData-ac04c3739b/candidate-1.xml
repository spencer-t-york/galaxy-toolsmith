    </requirements>
    <version_command>python -c "import anndata; print(anndata.__version__)"</version_command>
    <command detect_errors="exit_code">
        python -c '
            import sys
            import anndata
            import numpy as np
            import pandas as pd
            
            def read_anndata(file):
                if str(file.extension) == "h5ad":
                    return anndata.read_h5ad(str(file))
                elif str(file.extension) == "loom":
                    return anndata.read_loom(str(file))
            
            def write_anndata(adata, file):
                if str(file.extension) == "h5ad":
                    adata.write_h5ad(str(file))
                elif str(file.extension) == "loom":
                    adata.write_loom(str(file))

            adata = read_anndata($input)
            $concatenate:
                adata = anndata.AnnData.concatenate(
                    [adata] + [read_anndata(f) for f in $concatenate.files],
                    join=$concatenate.join,
                    batch_key=$concatenate.batch_key,
                    index_unique=$concatenate.index_unique
                )
            $make_obs_names_unique:
                adata.obs_names_make_unique()
            $make_var_names_unique:
                adata.var_names_make_unique()
            $rename_categories:
                adata.rename_categories(key="$rename_categories.key", categories=[str(c) for c in $rename_categories.categories])
            $remove_keys:
                for k in $remove_keys.keys:
                    del adata.obs[k]
                    del adata.var[k]
            $flag_genes_start_with:
                adata.var["flag"] = np.array([str(gene).startswith("$flag_genes_start_with") for gene in adata.var_names], dtype=int)
            $strings_to_categoricals:
                adata.strings_to_categoricals(keys=[str(k) for k in $strings_to_categoricals.keys])
            $transpose:
                adata = adata.transpose()
            $add_annotation_for_variables:
                adata.var["$add_annotation_for_variables.key"] = pd.Series([str(v) for v in $add_annotation_for_variables.values], index=adata.var_names)
            $split_by_obs_key:
                splits = list(adata.split_obs(key="$split_by_obs_key.key"))
                for split in splits:
                    write_anndata(split, "%s.%s" % ($output.name, split.obs[$split_by_obs_key.key].iloc[0]))
            $filter_observations:
                adata = adata[[str(i) for i in $filter_observations.indices]]
            $filter_variables:
                adata = adata[:, [str(i) for i in $filter_variables.indices]]
            $freeze_current_state_into_raw_attribute:
                adata.raw = adata.copy()

            write_anndata(adata, "$output")
        '
