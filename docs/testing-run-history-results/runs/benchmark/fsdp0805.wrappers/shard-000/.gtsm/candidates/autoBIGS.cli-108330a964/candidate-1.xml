<tool id="autobigs-cli" name="autoBIGS.cli" version="0.6.2+galaxy0" profile="24.1">
    <description>Automatically performs multi-locus sequence typing (MLST)</description>
    <macros/><xrefs>
        <xref type="bio.tools">autoBIGS</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="0.6.2">iuc.autobigs</requirement>
    </requirements>
    <version_command>autoBIGS --version</version_command>
    <command detect_errors="exit_code">
        mkdir -p ./input_fasta_files &amp;&amp;
        #for $fasta_file in $fasta_files
            ln -s '$fasta_file' './input_fasta_files/${fasta_file.element_identifier}.fasta' &amp;&amp;
        #end for
        autoBIGS
            --operation $operation.operation
            --database-name '$operation.database_name'
            --schema-id '$operation.schema_id'
            --input-directory ./input_fasta_files
            --output-csv '$output_csv'
            --log-level debug
    </command>
    <inputs>
        <param argument="--operation" type="select" label="Select Operation">
            <option value="retrieve_available_schemes_for_database" selected="true">Retrieve Available Schemes For Database</option>
            <option value="perform_sequence_typing">Perform Sequence Typing</option>
        </param>
        <conditional name="operation">
            <when value="retrieve_available_schemes_for_database"/>
            <when value="perform_sequence_typing">
                <param argument="--database-name" type="text" label="Database Name" help="Enter the name of the database you want to query."/>
                <param argument="--schema-id" type="text" label="Schema ID" help="Enter the schema ID you want to query."/>
            </when>
        </conditional>
        <param argument="--fasta-files" type="data_collection" collection_type="list" format="fasta" label="FASTA Files" help="Input FASTA files containing the sequences you wish to type."/>
    </inputs>
    <outputs>
        <data name="output_csv" format="csv" label="${tool.name} on ${on_string}: Output CSV File"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="operation" value="retrieve_available_schemes_for_database"/>
            <output name="output_csv" ftype="csv">
                <assert_contents>
                    <has_line line="scheme_id,scheme_name,scheme_description,scheme_url"/>
                </assert_contents>
            </output>
        </test>
